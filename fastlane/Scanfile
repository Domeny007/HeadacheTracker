project("HeadacheTracker.xcodeproj")
scheme("HeadacheTracker")
device("iPhone 17 Pro")
app_name("HeadacheTracker")

build_root = ENV.fetch("RUNNER_TEMP", "build")
derived_data_path("#{build_root}/DerivedData")

if ENV["RUNNER_TEMP"]
  cloned_source_packages_path("#{build_root}/SourcePackages")
end

xcargs("-skipPackagePluginValidation")
deployment_target_version("17.0")
output_types("junit")