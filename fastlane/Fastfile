default_platform(:ios)

platform :ios do
  desc "Собрать приложение и тестовые таргеты"
  lane :build_for_tests do
    run_tests(
      build_for_testing: true,
      output_directory: "build/reports"
    )
  end

  desc "Запустить unit-тесты из готовой сборки"
  lane :unit_tests do
    run_tests(
      test_without_building: true,
      only_testing: ["HeadacheTrackerTests"],
      xcodebuild_formatter: "",
      output_types: "junit",
      output_directory: "build/reports/unit"
    )
  end

  desc "Запустить UI-тесты из готовой сборки"
  lane :ui_tests do
    build_root = ENV.fetch(
      "RUNNER_TEMP",
      File.expand_path("../build", __dir__)
    )

    test_runs = Dir.glob(
      "#{build_root}/DerivedData/Build/Products/*.xctestrun"
    )

    unless test_runs.size == 1
      UI.user_error!("Ожидался один .xctestrun, найдено: #{test_runs.size}")
    end

    run_tests(
      xctestrun: test_runs.first,
      test_without_building: true,
      skip_package_dependencies_resolution: true,
      only_testing: ["HeadacheTrackerUITests"],
      output_directory: "build/reports/ui",
      parallel_testing: false,
      deployment_target_version: "17.0"
    )
  end
end